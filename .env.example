# ==============================================================================
# Stetho Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env or real credentials to source control.
# ==============================================================================

# --- Application & Server ---
PROJECT_NAME="Stetho API"
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Security & Authentication ---
# In production, replace with a secure random key (minimum 32 characters)
SECRET_KEY=stetho-dev-secret-key-32-chars-minimum-length-key!

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://stetho_user:stetho_password@localhost:5432/stetho_db
POSTGRES_USER=stetho_user
POSTGRES_PASSWORD=stetho_password
POSTGRES_DB=stetho_db

# --- Object Storage (Audio recordings & generated reports) ---
# Supported options: 'local', 's3', 'minio'
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./data/storage
S3_ENDPOINT_URL=
S3_BUCKET_NAME=stetho-audio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# --- Machine Learning & Hardware Target ---
# Path to machine-specific baseline model weights and calibration stats
MODEL_ARTIFACTS_DIR=./ml/artifacts
DEVICE_FALLBACK_TO_CPU=true

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

